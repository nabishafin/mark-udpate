{
  "name": "mdrn-life-ddw-experience",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "prebuild": "node scripts/check-secrets.mjs && node scripts/generate-sitemap.mjs",
    "build": "vite build && node scripts/prerender-seo.mjs && node scripts/validate-sitemap.mjs && node scripts/validate-seo.mjs",
    "validate:seo": "node scripts/validate-sitemap.mjs && node scripts/validate-seo.mjs",
    "validate:shopify": "node scripts/validate-shopify.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "start": "node server.js",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "framer-motion": "^11.5.4",
    "lucide-react": "0.522.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^20.11.18",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "latest",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "16.5.0",
    "postcss": "8.5.23",
    "tailwindcss": "3.4.17",
    "typescript": "^5.5.4",
    "vite": "^8.0.16"
  }
}
